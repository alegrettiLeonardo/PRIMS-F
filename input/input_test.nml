&PARAMS
  ! ==========================================================
  !  Scenario OSC (Case 17 - Table 3) - PRIMS-F robust settings
  ! ==========================================================

  ! -------------------- Geometry / mesh ----------------------
  nodes           = 141
  num_dummy_cells = 2
  X               = 6.435
  Z               = 9.886
  Lp              = 57.4
  beta_deg        = 2.0

  ! -------------------- Physical properties -----------------
  rho_l0          = 997.05
  P_l0            = 101325.0
  Cl              = 1498.0
  Rg              = 287.053
  mu_l            = 0.89e-3
  mu_g            = 1.85e-5
  eps             = 4.6e-5
  D               = 0.0508
  sigma           = 7.28e-2
  G               = 9.81

  ! -------------------- Scenario (OSC) ----------------------
  Ps              = 2.06e5
  jl              = 0.84
  jg              = 0.46
  Tgas            = 311.95
  time_dim        = 1.0
  gamma_g         = 1.4

  ! -------------------- Numerics -----------------------------
  CFL             = 20.0

  ! Newton tolerances (avoid over-solving)
  tol             = 1.0e-9
  tola            = 1.0e-9
  tol_res         = 1.0e-7
  tol_inc         = 1.0e-7

  quad_points     = 3
  max_iter        = 20000
  max_workers     = 16
  newton_max      = 25

  ! -------------------- Time-step control --------------------
  dt_start        = 1.0e-6
  dt_min          = 1.0e-10
  dt_max          = 5.0e-2

  ! Adaptive dt targeting ~7 Newton iterations (inexact Newton regime)
  use_it_target   = .true.
  it_target       = 12
  it_p            = 0.7
  dt_fac_min      = 0.3
  dt_fac_max      = 1.6

  ! -------------------- High-quality Jacobian options --------
  ! Include a FD correction for Roe dissipation dependence:
  !   dFhat/dU += -0.5 * (d|A|/dU) * (UR-UL)
  ! This is more expensive but can restore superlinear convergence in tough transients.
  jac_dissipation_fd = .true.
  jac_dissipation_fd_eps = 1.0e-7


  ! Debug: compare DFduj(analytic) vs central FD at one cell (prints to stdout once)
  debug_dfduj_check = .true.
  debug_dfduj_cell  = 0     ! 0 -> middle cell
  debug_dfduj_eps   = 1.0e-7

  ! -------------------- Labels -------------------------------
  regime          = 'OSC'
  out_dir         = 'output'
/
